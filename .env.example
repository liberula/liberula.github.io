# Endpoint público da Supabase Edge Function lead-submit.
# https://<project-ref>.supabase.co/functions/v1/lead-submit
NEXT_PUBLIC_ECO_FORM_ENDPOINT=

# URL-base da Edge Function eco-sp-001-api, sem o endpoint final.
# https://<project-ref>.supabase.co/functions/v1/eco-sp-001-api
NEXT_PUBLIC_ECO_API_BASE_URL=

# Data ISO fixa de encerramento, incluindo timezone.
NEXT_PUBLIC_ECO_RECRUITMENT_END_AT=2026-07-24T23:59:59-03:00

# ID numérico do Meta Pixel. Deixe vazio para manter o pixel desativado.
NEXT_PUBLIC_META_PIXEL_ID=

# Analytics já usado pelo restante do site. Confirme US ou EU no painel.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Painel local de operações E.C.O. Use somente em .env.local.
# URL HTTPS do projeto Supabase Liberula, sem caminho adicional.
ECO_ADMIN_SUPABASE_URL=
# Secret API key moderna (sb_secret_...) de servidor. Nunca use prefixo NEXT_PUBLIC_.
ECO_ADMIN_SUPABASE_SECRET_KEY=
# URL da função eco-case-delivery. Opcional quando derivável da URL acima.
ECO_DELIVERY_FUNCTION_URL=
# Segredo administrativo já usado pela função eco-case-delivery.
ECO_DELIVERY_ADMIN_SECRET=
