# Endpoint público da Supabase Edge Function eco-lead.
# https://<project-ref>.supabase.co/functions/v1/eco-lead
NEXT_PUBLIC_ECO_FORM_ENDPOINT=

# URL-base da Edge Function eco-sp-001-api, sem o endpoint final.
# https://<project-ref>.supabase.co/functions/v1/eco-sp-001-api
NEXT_PUBLIC_ECO_API_BASE_URL=

# URL pública opcional do Instagram oficial da E.C.O. Deve usar https://instagram.com/.
# Quando vazia ou inválida, nenhum link é exibido e as pistas continuam totalmente locais.
NEXT_PUBLIC_ECO_INSTAGRAM_URL=

# Origem pública do projeto Supabase Liberula, sem caminho ou credencial.
# https://<project-ref>.supabase.co
NEXT_PUBLIC_LIBERULA_SUPABASE_URL=

# ID numérico do Meta Pixel. Deixe vazio para manter o pixel desativado.
NEXT_PUBLIC_META_PIXEL_ID=

# Analytics já usado pelo restante do site. Confirme US ou EU no painel.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Restrição server-side das candidaturas E.C.O. Apenas "true" fecha o recrutamento.
ECO_RECRUITMENT_CLOSED=false

# Painel local de operações E.C.O. Use somente em .env.local.
# URL HTTPS do projeto Supabase Liberula, sem caminho adicional.
ECO_ADMIN_SUPABASE_URL=
# Secret API key moderna (sb_secret_...) de servidor. Nunca use prefixo NEXT_PUBLIC_.
ECO_ADMIN_SUPABASE_SECRET_KEY=
# URL da função eco-case-delivery. Opcional quando derivável da URL acima.
ECO_DELIVERY_FUNCTION_URL=
# Segredo administrativo compartilhado por eco-case-delivery, eco-automation-settings e pelo dispatcher automático.
ECO_DELIVERY_ADMIN_SECRET=

# Pagamentos ECO-SP-001 (somente Supabase Edge Functions; nunca NEXT_PUBLIC_).
# Chave operacional: apenas o valor exato "true" permite criar novos pedidos.
ECO_PAYMENTS_ENABLED=false
# Ambiente explícito: "development" (localhost sandbox), "test" (preview sandbox) ou "production".
MERCADO_PAGO_ENVIRONMENT=development
# Access Token correspondente exatamente ao ambiente acima.
MERCADO_PAGO_ACCESS_TOKEN=
# Assinatura secreta do Webhook da mesma aplicação/ambiente.
MERCADO_PAGO_WEBHOOK_SECRET=
# Collector/user ID numérico da conta vendedora esperada.
MERCADO_PAGO_COLLECTOR_ID=
# Origens adicionais exatas, separadas por vírgula; produção oficial já é aceita.
ECO_ALLOWED_ORIGINS=
# Valor aleatório server-side com pelo menos 32 caracteres para o rate limit de status.
ECO_STATUS_RATE_LIMIT_SALT=
# Fornecidos automaticamente pelo Supabase nas Edge Functions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail pós-compra do agente fundador (somente Supabase Edge Functions).
# Segredo compartilhado entre webhook e dispatcher; gere valor aleatório forte.
ECO_FOUNDER_EMAIL_SECRET=
# URL HTTPS exata da função eco-founder-post-purchase-dispatch.
ECO_FOUNDER_EMAIL_DISPATCH_URL=
# URL HTTPS da página do site /eco/eco-sp-001/registros/quina-final.
ECO_FOUNDER_RECORD_PAGE_URL=
# URL HTTPS exata da função eco-founder-record, sem query string.
ECO_FOUNDER_RECORD_API_URL=
# Mesmo endpoint público usado pelo cliente; não é uma credencial.
NEXT_PUBLIC_ECO_FOUNDER_RECORD_API_URL=
# Origem HTTPS pública do site, também usada pelos envios de caso existentes.
ECO_PUBLIC_BASE_URL=
# Salt aleatório server-side com pelo menos 32 caracteres para acesso ao registro.
ECO_FOUNDER_RECORD_RATE_LIMIT_SALT=
# Endereço público de suporte exibido no e-mail.
ECO_SUPPORT_EMAIL=
# Credenciais Postmark já usadas pelos envios E.C.O.; nunca usar NEXT_PUBLIC_.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_REPLY_TO=
POSTMARK_MESSAGE_STREAM=
